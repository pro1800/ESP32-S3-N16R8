# macOS 系统文件
.DS_Store
.AppleDouble
.LSOverride

# 目录元数据
.directory

# 临时文件
*~
*.swp
*.swo
*.bak
*.tmp
*.orig

# 日志文件
*.log
openocd.log
idf_monitor.*

# 编译产物
build/
*.o
*.a
*.out
*.exe

# ESP-IDF 编译输出
*.bin
*.elf
*.map
flasher_args.json
flash_download.cfg
partition_table.bin
sdkconfig.old
# sdkconfig 必须提交，保证跨设备配置一致

# ESP-IDF 组件缓存
**/components/.idf/
#managed_components/
.espressif/

# CMake 生成文件
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python 环境
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Python 虚拟环境
venv/
.venv/
env/

# 代码索引缓存
.clangd/
.ccls-cache/
compile_commands.json

# Windows 系统文件
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE 用户私有配置
*.user
*.workspace
*.suo
*.sln.docstates

# VSCode 本机私有配置（含绝对路径，跨设备冲突）
.vscode/settings.json
.vscode/c_cpp_properties.json
.vscode/ipch/
.vscode/*.log

# 调试历史
.gdb_history

# 本地秘钥、环境配置（禁止提交敏感信息）
.env
.env.local